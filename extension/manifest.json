{
  "manifest_version": 3,
  "name": "Google Maps Scraper Pro v1.1",
  "version": "1.1.0",
  "description": "⚡ ULTRA OPTIMIZED: Scrape Google Maps with terminal-style UI, parallel processing, and 15+ data fields",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Maps Scraper Pro v1.1 - TERMINAL MODE"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
